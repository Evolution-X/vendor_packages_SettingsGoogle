    <string name="simple_mode_category">فوری رسائی</string>
    <string name="simple_mode_description">ٹیکسٹ اور آئیکن کا سائز بڑھائیں، لے آؤٹ کو آسان بنائيں اور نیویگیشن بٹنز شامل کریں۔ LINK_BEGINآسان منظر کے بارے میں مزید جانیں۔LINK_END</string>
