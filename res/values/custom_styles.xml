<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Locale Picker -->
    <style name="Theme.Settings.LocalePicker" parent="@style/Theme.Settings">
        <item name="android:windowNoTitle">true</item>
        <item name="android:clipChildren">true</item>
        <item name="android:clipToPadding">true</item>
    </style>

    <!-- Simple Mode -->
    <style name="SimpleViewNegativeButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>

    <style name="SimpleViewPositiveButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/simple_view_colored_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>

    <!-- Biometrics -->
    <style name="TextAppearance.FaceErrorText" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?android:attr/colorError</item>
    </style>

    <style name="FrrEntryButtonExpressiveStyle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:clickable">true</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:fontFamily">@string/sudFontSecondaryText</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="FrrEntryDescriptionExpressiveStyle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:fontFamily">@string/sudFontSecondaryText</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="FrrEntryExpressiveStyle" parent="">
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="FrrEntryIconExpressiveStyle" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="FrrEntryTitleExpressiveStyle" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:fontFamily">@string/sudFontSecondary</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
