    <string name="simple_mode_category">Ufikiaji wa haraka</string>
    <string name="simple_mode_description">Ongeza ukubwa wa maandishi na aikoni, rahisisha muundo na uweke vitufe vya usogezaji. LINK_BEGINPata maelezo zaidi kuhusu Mwonekano Rahisi.LINK_END</string>
