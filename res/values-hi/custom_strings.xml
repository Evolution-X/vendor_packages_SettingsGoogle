    <!-- Battery Saver -->
    <string name="basic_battery_saver_title">स्टैंडर्ड बैटरी सेवर</string>
    <string name="basic_battery_saver_summary">यह मोड, विज़ुअल इफ़ेक्ट के इस्तेमाल और बैकग्राउंड में होने वाली गतिविधि को कम करता है. अगर गहरे रंग वाली थीम पहले से चालू नहीं है, तो उसे भी चालू करता है.</string>
    <string name="extreme_battery_saver_title">एक्स्ट्रीम बैटरी सेवर</string>
    <string name="extreme_battery_saver_summary">ऊपर बताए गए सभी बदलाव लागू होंगे. इसके साथ ही, यह ग़ैर-ज़रूरी ऐप्लिकेशन की गतिविधियों और उनसे मिलने वाली सूचनाओं को रोक देगा.</string>

