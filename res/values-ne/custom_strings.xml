    <!-- Simple Mode -->
    <string name="simple_mode_category">क्विक एक्सेस</string>
    <string name="simple_mode_description">टेक्स्ट र आइकनको आकार बढाउनुहोस्, लेआउट सरल बनाउनुहोस् र नेभिगेसन बटनहरू हाल्नुहोस्। LINK_BEGINसिम्पल भ्यूका बारेमा थप जान्नुहोस्।LINK_END</string>
    <string name="simple_mode_off_summary">अफ छ / स्क्रिनको लेआउट सरल बनाउनुहोस् र टेक्स्ट सजिलैसँग पढ्न सकिने बनाउनुहोस्</string>
    <string name="simple_mode_on_summary">अन छ / स्क्रिनको लेआउट सरल बनाउनुहोस् र टेक्स्ट सजिलैसँग पढ्न सकिने बनाउनुहोस्</string>
    <string name="simple_mode_summary">टेक्स्ट अझ सजिलोसँग पढ्न मिल्ने बनाउनुहोस् र स्क्रिनको लेआउट तथा नेभिगेसन गर्ने सुविधा अझ सरल बनाउनुहोस्</string>
    <string name="simple_mode_suw_description">डिजाइन र अनबोर्डिङ प्रक्रिया सरल बनाउन Pixel ले अत्यावश्यक एप र विजेट स्वतः डाउनलोड गर्ने, स्क्रिनको लेआउट अप्टिमाइज गर्ने, फन्ट मिलाउनेलगायतका कार्यहरू गर्न सक्छ</string>
    <string name="simple_mode_suw_done_button">सम्पन्न भयो</string>
