<?xml version="1.0" encoding="utf-8"?>
<com.google.android.setupdesign.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/face_enroll_confirmation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/FaceLayoutTheme">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        style="@style/SudContentFrame">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lock_screen_bypass_lottie"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lock_screen_bypass_lottie_height"
            android:scaleType="centerInside"
            app:lottie_autoPlay="true"
            app:lottie_loop="false"
            style="@style/SudContentIllustration"/>
        <com.google.android.settings.biometrics.face.FaceEnrollLockScreenBypassToggle
            android:id="@+id/lock_screen_bypass_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"/>
    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
