<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:androidprv="http://schemas.android.com/apk/prv/res/android" xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/face_layout_theme">
    <com.google.android.setupdesign.view.RichTextView
        android:textSize="22sp"
        android:textColor="@color/materialColorOnSurface"
        android:gravity="start"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:minHeight="28dp"
        android:text="@string/lockscreen_bypass_title"
        android:maxLines="2"
        android:fontFamily="@string/sudFontSecondary"
        android:layout_toStartOf="@+id/toggle"
        android:layout_alignParentStart="true"
        android:letterSpacing="0"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/materialColorOnSurfaceVariant"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:text="@string/lockscreen_bypass_summary"
        android:layout_below="@+id/title"
        android:fontFamily="@string/sudFontSecondaryText"
        android:layout_toStartOf="@+id/toggle"
        android:layout_alignParentStart="true"
        android:letterSpacing="0"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:theme="@style/Theme.Material3.DynamicColors.DayNight"
        android:id="@+id/toggle"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
