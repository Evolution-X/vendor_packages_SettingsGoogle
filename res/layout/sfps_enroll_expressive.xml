<?xml version="1.0" encoding="utf-8"?>
<com.google.android.setupdesign.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/fingerprint_layout_theme">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/SudContentFrame">
        <RelativeLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/progress_lottie"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:translationX="0dp">
            <com.google.android.setupdesign.view.FillContentLayout
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="@dimen/fingerprint_progress_bar_max_size"
                android:layout_height="@dimen/fingerprint_progress_bar_max_size">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/illustration_lottie"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="@dimen/sfps_illustration_layout_width_expressive"
                    android:layout_height="@dimen/sfps_illustration_layout_height_expressive"
                    android:layout_marginBottom="@dimen/sfps_illustration_margin_bottom_expressive"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/sfps_illustration_margin_end_expressive"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_speed="0.85"
                    style="@style/SudContentIllustration"/>
                <com.android.settings.widget.RingProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/fingerprint_progress_bar"
                    android:layout_width="@dimen/fingerprint_progress_bar_adjust_size_expressive"
                    android:layout_height="@dimen/fingerprint_progress_bar_adjust_size_expressive"
                    android:layout_marginTop="@dimen/sfps_progress_bar_translate_y_expressive"
                    android:progress="0"
                    android:progressDrawable="@drawable/ring_progress_expressive"
                    android:minHeight="@dimen/fingerprint_progress_bar_min_size"
                    android:layout_marginStart="@dimen/sfps_progress_bar_translate_x_expressive"
                    android:progressBackgroundTint="@color/sfps_enrollment_progress_bar_bg_color"/>
            </com.google.android.setupdesign.view.FillContentLayout>
            <TextView
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/error_text"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                style="@style/TextAppearance.ErrorText"/>
        </RelativeLayout>
    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
