<?xml version="1.0" encoding="utf-8"?>
<com.google.android.setupdesign.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="?attr/fingerprint_layout_theme">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sfps_enrollment_finish_content_frame"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/SudContentFrame">
        <com.google.android.setupdesign.view.FillContentLayout
            android:layout_gravity="center"
            android:id="@+id/sfps_enrollment_finish_content_layout"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/sfps_enroll_finish_lottie"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="@dimen/sfps_enrollment_finished_icon_max_size"
                android:layout_height="@dimen/sfps_enrollment_finished_icon_max_size"
                android:scaleType="centerInside"
                android:contentDescription="@string/settingslib_illustration_content_description"
                android:importantForAccessibility="yes"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/fingerprint_enroll_finish_expressive"
                app:lottie_speed="0.85"
                style="@style/SudContentIllustration"/>
        </com.google.android.setupdesign.view.FillContentLayout>
    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
