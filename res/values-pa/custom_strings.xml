    <!-- Battery Saver -->
    <string name="basic_battery_saver_title">ਸਟੈਂਡਰਡ ਬੈਟਰੀ ਸੇਵਰ</string>
    <string name="basic_battery_saver_summary">ਦ੍ਰਿਸ਼ਟੀਗਤ ਪ੍ਰਭਾਵਾਂ ਅਤੇ ਬੈਕਗ੍ਰਾਊਂਡ ਸਰਗਰਮੀ ਨੂੰ ਸੀਮਤ ਕਰਦਾ ਹੈ। ਜੇ ਗੂੜ੍ਹਾ ਥੀਮ ਪਹਿਲਾਂ ਤੋਂ ਚਾਲੂ ਨਹੀਂ ਹੈ, ਤਾਂ ਉਸਨੂੰ ਚਾਲੂ ਕਰਦਾ ਹੈ।</string>
    <string name="extreme_battery_saver_title">ਐਕਸਟ੍ਰੀਮ ਬੈਟਰੀ ਸੇਵਰ</string>
    <string name="extreme_battery_saver_summary">ਇਸ ਵਿਸ਼ੇਸ਼ਤਾ ਵਿੱਚ ਉੱਪਰ ਸੂਚੀਬੱਧ ਕੀਤੀਆਂ ਸਾਰੀਆਂ ਤਬਦੀਲੀਆਂ ਸ਼ਾਮਲ ਹਨ। ਇਹ ਗੈਰ-ਜ਼ਰੂਰੀ ਐਪਾਂ ਅਤੇ ਉਨ੍ਹਾਂ ਦੀਆਂ ਸੂਚਨਾਵਾਂ ਨੂੰ ਵੀ ਰੋਕਦੀ ਹੈ।</string>

