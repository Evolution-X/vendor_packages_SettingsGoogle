<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sfps_enroll.xml"
    app:startDestination="@+id/intro">
    <fragment
        android:label="Intro"
        android:name="com.google.android.settings.biometrics.fingerprint.ui.view.IntroFragment"
        android:id="@+id/intro">
        <action
            android:id="@+id/action_intro_to_find_sensor"
            app:destination="@+id/find_sensor"/>
    </fragment>
    <fragment
        android:label="FindSensor"
        android:name="com.google.android.settings.biometrics.sfps.view.FindSfpsFragment"
        android:id="@+id/find_sensor">
        <action
            android:id="@+id/action_find_sensor_to_enroll"
            app:destination="@+id/enroll"/>
    </fragment>
    <fragment
        android:label="EnrollSfps"
        android:name="com.google.android.settings.biometrics.sfps.view.EnrollSfpsFragment"
        android:id="@+id/enroll">
        <action
            android:id="@+id/action_enrolling_to_finish"
            app:destination="@+id/finish"
            app:enterAnim="@anim/shared_x_axis_activity_open_enter_dynamic_color"
            app:exitAnim="@anim/shared_x_axis_activity_open_exit"
            app:popEnterAnim="@anim/shared_x_axis_activity_close_enter_dynamic_color"
            app:popExitAnim="@anim/shared_x_axis_activity_close_exit"
            app:popUpTo="@+id/enroll"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="EnrollConfirmationSfps"
        android:name="com.google.android.settings.biometrics.sfps.view.ConfirmSfpsFragment"
        android:id="@+id/finish">
        <action
            android:id="@+id/action_finish_to_enrolling"
            app:destination="@+id/enroll"
            app:enterAnim="@anim/shared_x_axis_activity_open_enter_dynamic_color"
            app:exitAnim="@anim/shared_x_axis_activity_open_exit"
            app:popEnterAnim="@anim/shared_x_axis_activity_close_enter_dynamic_color"
            app:popExitAnim="@anim/shared_x_axis_activity_close_exit"
            app:popUpTo="@+id/finish"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
