    <!-- Simple Mode -->
    <string name="simple_mode_category">झटपट ॲक्सेस</string>
    <string name="simple_mode_description">मजकूराचा आणि आयकनचा आकार वाढवा, लेआउट साधा करा आणि नेव्हिगेशन बटणे जोडा. LINK_BEGINसुलभ दृश्य याविषयी अधिक जाणून घ्या.LINK_END</string>
    <string name="simple_mode_off_summary">बंद / स्क्रीन लेआउट साधा करा आणि मजकूर वाचण्यास सोपा करा</string>
    <string name="simple_mode_on_summary">सुरू / स्क्रीन लेआउट साधा करा आणि मजकूर वाचण्यास सोपा करा</string>
    <string name="simple_mode_summary">मजकुराच्या सुवाच्यतेमध्ये सुधारणा करा आणि स्क्रीन लेआउट व नेव्हिगेशन सोपे करा</string>
    <string name="simple_mode_suw_description">सुटसुटीत डिझाइन आणि सहजसोप्या ऑनबोर्डिंगसाठी, Pixel हे आवश्यक ॲप्स व विजेट आपोआप डाउनलोड करू शकते, स्क्रीन लेआउट ऑप्टिमाइझ करू शकते, फॉंट अ‍ॅडजस्ट करू शकते आणि आणखी बरेच काही करू शकते</string>
    <string name="simple_mode_suw_done_button">पूर्ण झाले</string>
