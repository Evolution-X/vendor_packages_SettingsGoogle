    <!-- Default summary of the subpage of content protection settings. Will be overlaid by OEM. -->
    <string name="content_protection_preference_subpage_summary">Skanningen kjøres privat, direkte på enheten din, og kontrollerer appaktivitet for å oppdage nettfisking og annen villedende funksjonalitet. Hvis noe av dette blir funnet, sender funksjonen noe appinformasjon til Google Play Protect for å bekrefte trusselen og advare appbrukere.</string>

    <!-- Default information at the bottom of the subpage of content protection settings. Will be overlaid by OEM. -->
    <string name="content_protection_preference_subpage_info">Dette er en beskyttet sikkerhetsfunksjon. Ingen enhetsinformasjon eller personopplysninger deles med Google. \n\nNettfisking er et forsøk på å stjele påloggingslegitimasjon eller andre personopplysninger.</string>

